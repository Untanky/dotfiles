font-family = "Monaspace Neon Regular"
font-family-bold = "Monaspace Neon Bold"
font-family-italic = "Monaspace Neon Regular Italic"
font-family-bold-italic = "Monaspace Neon Bold Italic"
font-feature = "ss01"
font-feature = "ss02"
font-feature = "ss03"
font-feature = "ss04"
font-feature = "liga"
theme = catppuccin-macchiato.conf
keybind = super+shift+D=new_split:down
macos-icon = glass
cursor-style = bar
cursor-style-blink = true
cursor-click-to-move = true
mouse-hide-while-typing = true
fullscreen = true
window-padding-x = 2
window-padding-y = 2
window-padding-balance = true
window-padding-color = extend
copy-on-select = true
shell-integration-features = true
faint-opacity = 0.75
